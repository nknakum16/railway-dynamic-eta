# RailRadar API Settings
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1
RAILRADAR_TIMEOUT_SECONDS=10.0

# Security & Authentication
SECRET_KEY=your_secure_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Calendarific Festival API
CALENDARIFIC_API_KEY=your_calendarific_api_key_here
CALENDARIFIC_BASE_URL=https://calendarific.com/api/v2
CALENDARIFIC_COUNTRY=IN
CALENDARIFIC_CACHE_DIR=data/festivals
FESTIVAL_WINDOW_DAYS=3

# Cache Settings (in seconds)
CACHE_TTL_LIVE_SECONDS=30
CACHE_TTL_STATIC_SECONDS=3600

# Mock & Resilience
ENABLE_MOCK_FALLBACK=true

# Database
DATABASE_URL=sqlite:///./railway.db

# CORS
CORS_ORIGINS=["*"]

